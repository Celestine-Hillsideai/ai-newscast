# Required now — used by src/lib/supabase.ts (Phase 1) and the Phase 2/3/4
# providers (src/lib/providers/). Set these locally in a gitignored .env for
# `trigger.dev dev`, AND in the Trigger.dev dashboard's Environment Variables
# page for deployed runs (both Development and Production environments).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TAVILY_API_KEY=        # discover-news (src/lib/providers/news-search.ts)
FIRECRAWL_API_KEY=     # extract-articles (src/lib/providers/article-extraction.ts)
OPENAI_API_KEY=        # verify-news + summarize-news + generate-podcast-script (src/lib/providers/llm.ts)
# OPENAI_MODEL=          # optional, defaults to gpt-4o-mini
ELEVENLABS_API_KEY=    # generate-audio (src/lib/providers/tts.ts)
# ELEVENLABS_VOICE_ID=   # optional, defaults to ElevenLabs' premade "Rachel" voice
# ELEVENLABS_MODEL_ID=   # optional, defaults to eleven_multilingual_v2
